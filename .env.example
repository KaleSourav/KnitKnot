# Knotsnco Environment Configuration

# 1. Shopify Storefront API (for catalog browsing & cart)
VITE_SHOPIFY_STORE_DOMAIN="04wv6h-ut.myshopify.com"
VITE_SHOPIFY_STOREFRONT_TOKEN="0c626353bdea1d2a4c8f32890eb14565"
VITE_SHOPIFY_API_VERSION="2026-10"

# 2. Shopify Admin API (Shopify Dev Dashboard: Knotsnco Backend Integration)
# Uses Shopify Client Credentials Grant: POST https://{store-domain}/admin/oauth/access_token
# Requires the 4 environment variables below:
SHOPIFY_STORE_DOMAIN="04wv6h-ut.myshopify.com"
SHOPIFY_CLIENT_ID=""
SHOPIFY_CLIENT_SECRET=""
SHOPIFY_ADMIN_API_VERSION="2026-10"

# 3. Razorpay API Credentials
# Get from Razorpay Dashboard -> Settings -> API Keys
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
VITE_RAZORPAY_KEY_ID=""

# 4. Razorpay Webhook Secret
# Set in Razorpay Dashboard -> Settings -> Webhooks -> Add New Webhook
# URL: https://your-domain.com/api/webhooks/razorpay
# Secret: enter a strong random string here and into Razorpay dashboard
# Events: payment.captured, order.paid, payment_link.paid
RAZORPAY_WEBHOOK_SECRET=""

# 5. Server & Frontend Settings
PORT=3001
FRONTEND_URL="http://localhost:3000"

# 6. Durable Order Persistence (Required for Vercel Serverless Functions in production)
# Vercel functions have read-only filesystems. Configure Vercel KV or Upstash Redis to persist
# pending orders and webhook events across stateless invocations.
# (Automatically populated by Vercel when adding the Vercel KV / Upstash Storage integration)
KV_REST_API_URL=""
KV_REST_API_TOKEN=""
# Or Upstash Redis directly:
# UPSTASH_REDIS_REST_URL=""
# UPSTASH_REDIS_REST_TOKEN=""
