# Knotsnco Environment Configuration

# 1. Shopify Storefront API (for catalog browsing & cart)
VITE_SHOPIFY_STORE_DOMAIN="04wv6h-ut.myshopify.com"
VITE_SHOPIFY_STOREFRONT_TOKEN="0c626353bdea1d2a4c8f32890eb14565"
VITE_SHOPIFY_API_VERSION="2026-10"

# 2. Shopify Admin API (Used by backend to create verified PAID orders)
# Generate from Shopify Admin -> Settings -> Apps and sales channels -> Develop apps
# Supports direct Access Token OR Client ID + Client Secret with write_orders scope
SHOPIFY_STORE_DOMAIN="04wv6h-ut.myshopify.com"
SHOPIFY_ADMIN_ACCESS_TOKEN=""
SHOPIFY_CLIENT_ID=""
SHOPIFY_CLIENT_SECRET=""
SHOPIFY_ADMIN_API_VERSION="2026-10"

# 3. Razorpay API Credentials
# Get from Razorpay Dashboard -> Settings -> API Keys
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
VITE_RAZORPAY_KEY_ID=""

# 4. Razorpay Webhook Secret
# Set in Razorpay Dashboard -> Settings -> Webhooks -> Add New Webhook
# URL: https://your-domain.com/api/webhooks/razorpay
# Secret: enter a strong random string here and into Razorpay dashboard
# Events: payment.captured, order.paid, payment_link.paid
RAZORPAY_WEBHOOK_SECRET=""

# 5. Server & Frontend Settings
PORT=3001
FRONTEND_URL="http://localhost:3000"
